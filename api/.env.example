# api/.env.example — copy to api/.env and fill in real values.
# Never commit the populated file.

NODE_ENV=development
PORT=3000

# MySQL connection string.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/axle

# Reserved for later phases. Safe defaults shown.
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me-32-bytes-hex-here-change-me

# Provider API keys (server-side only, never returned to clients).
GEMINI_API_KEY=
OPENAI_API_KEY=
