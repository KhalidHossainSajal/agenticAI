# Copy to `.env` (api service reads from this path) and fill in real values.
# Never commit the populated `.env` file.

NODE_ENV=development
PORT=3000

# MySQL connection string used by the api service.
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:root@127.0.0.1:3306/axle

# Web (Vite) reads this to find the api.
VITE_API_URL=http://localhost:3000

# Reserved for later phases; safe defaults shown.
JWT_SECRET=change-me-please-replace-this
ENCRYPTION_KEY=change-me-32-bytes-hex-here-change-me

# Provider API keys (server-side only, never exposed to the web client).
GEMINI_API_KEY=
OPENAI_API_KEY=
